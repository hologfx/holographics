{
	"name": "holographics",
	"productName": "Holographics",
	"version": "1.12.0-beta.8",
	"author": "Stream My Event",
	"copyright": "Stream My Event B.V.",
	"homepage": "https://github.com/hologfx/holographics",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hologfx/holographics.git"
	},
	"description": "Live graphics reimagined",
	"main": "./dist/server/electron.js",
	"browserslist": [
		"defaults",
		"chrome 62",
		"chrome 63",
		"chrome 51"
	],
	"build": {
		"appId": "streammyevent.holographics",
		"asar": false,
		"npmRebuild": false,
		"compression": "normal",
		"extraResources": [],
		"files": [
			"dist/",
			"dist/**/node_modules/**/*",
			"!*.map",
			"!**/*.map"
		],
		"directories": {
			"output": "./builds"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "hologfx",
				"repo": "holographics"
			}
		],
		"mac": {
			"category": "public.app-category.video",
			"hardenedRuntime": true
		},
		"win": {
			"target": "nsis",
			"azureSignOptions": {
				"publisherName": "Stream My Event B.V.",
				"endpoint": "https://neu.codesigning.azure.net",
				"codeSigningAccountName": "holographics",
				"certificateProfileName": "holographics-ci-signing"
			}
		}
	},
	"ntl": {
		"descriptions": {}
	},
	"scripts": {
		"start": "ntl",
		"client": "webpack-dev-server --config webpack.dev.js",
		"server": "nodemon --exec cross-env NODE_ENV=development node --inspect ./src/entry_server.js ",
		"CLI": "node ./src/entry_repl.js",
		"rebuild:node": "npm rebuild",
		"rebuild:electron": "electron-builder install-app-deps",
		"dev:electron": "nodemon --exec cross-env NODE_ENV=development electron --inspect ./src/entry_electron.js ",
		"dev:electron:packed": "nodemon --exec 'npm run build:webpack:nodejs && npm run build:webpack:electron && cross-env NODE_ENV=development electron ./dist/server/electron.js'",
		"prod:nodejs": "nodemon --exec 'npm run build:webpack:nodejs && node ./dist/server/server.js'",
		"prod:electron": "npm run build:webpack:nodejs && npm run build:webpack:electron && npm run compile:maconly && ./builds/mac-arm64/Holographics.app/Contents/MacOS/Holographics",
		"prod:docker": "docker run -it -p 3000:3000 holographics",
		"build:clientsdk": "node ./tasks/generate_sdk",
		"build:hashes": "node ./tasks/generate_hashes",
		"build:notices": "node ./tasks/generate_notices",
		"build:fonts": "rm ./src/client/public/google_fonts/google_fonts.css && ./tasks/generate_fonts.sh && node ./tasks/generate_fontlist.js",
		"build:docker": "docker build -t holographics . && docker image prune -f",
		"build:webpack": "npm run build:notices && npm run build:webpack:client && npm run build:webpack:nodejs && npm run build:webpack:electron",
		"build:webpack:client": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --hide-modules --mode production --config webpack.prod.js",
		"build:webpack:nodejs": "webpack --hide-modules --mode production --config webpack.node.js",
		"build:webpack:electron": "webpack --hide-modules --mode production --config webpack.electron.js",
		"compile:packed": "electron-builder --dir",
		"compile:maconly": "electron-builder --mac dir",
		"compile:distributable": "electron-builder -mw",
		"test": "mocha --recursive --exit",
		"test:generate_coverage": "istanbul cover node_modules/mocha/bin/_mocha -- -R spec",
		"build_and_deploy": "electron-builder -mw --publish always",
		"postinstall": "npm run build:clientsdk"
	},
	"license": "AGPL-3.0-only",
	"dependencies": {
		"atem-connection": "^1.3.0",
		"macadam": "git+https://github.com/hologfx/macadam.git#1c72357",
		"axios": "^0.18.1",
		"body-parser": "^1.19.0",
		"build-url": "^2.0.0",
		"chalk": "^1.1.3",
		"chokidar": "^3.4.0",
		"color": "^3.1.2",
		"electron-builder-notarize": "^1.5.2",
		"electron-is-dev": "^0.3.0",
		"electron-updater": "^6.8.9",
		"express": "^4.17.1",
		"file-type": "^12.4.2",
		"fs-extra": "^7.0.0",
		"ip": "^1.1.5",
		"lodash": "^4.17.15",
		"lodash-id": "^0.14.0",
		"lowdb": "^1.0.0",
		"moment": "^2.26.0",
		"morgan": "^1.10.0",
		"osc-js": "^2.1.0",
		"pluralize": "^7.0.0",
		"pug": "^2.0.4",
		"rand-token": "^0.4.0",
		"semver": "^6.1.2",
		"serve-favicon": "^2.5.0",
		"socket.io": "^2.3.0",
		"source-map-support": "^0.5.19",
		"stylus": "^0.54.7",
		"system-font-families": "^0.4.1",
		"vm2": "^3.9.2",
		"webpack-copy-plugin": "0.0.4"
	},
	"devDependencies": {
		"@babel/core": "^7.10.2",
		"@babel/plugin-syntax-dynamic-import": "^7.8.3",
		"@babel/polyfill": "^7.10.1",
		"@babel/preset-env": "^7.10.2",
		"@fortawesome/fontawesome-free": "^5.13.0",
		"babel-loader": "^8.1.0",
		"benchmark": "^2.1.4",
		"bootstrap": "^4.1.3",
		"brace": "^0.11.1",
		"chai": "3.5.0",
		"clean-webpack-plugin": "^3.0.0",
		"copy-webpack-plugin": "^6.0.2",
		"cross-env": "^5.2.1",
		"css-loader": "^1.0.0",
		"debug": "^4.1.1",
		"electron": "^42.5.0",
		"electron-builder": "^26.15.3",
		"element-ui": "^2.13.2",
		"eslint": "^6.8.0",
		"eslint-config-prettier": "^6.11.0",
		"eslint-config-standard": "^14.1.1",
		"eslint-plugin-import": "^2.21.1",
		"eslint-plugin-mocha": "^6.3.0",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^3.1.3",
		"eslint-plugin-promise": "^4.2.1",
		"eslint-plugin-standard": "^4.0.1",
		"eslint-plugin-vue": "^6.2.2",
		"express-list-routes": "^0.1.4",
		"extract-loader": "^5.1.0",
		"file-loader": "^2.0.0",
		"google-fonts-offline": "^0.1.5",
		"gsap": "^3.13.0",
		"holographics-client-sdk": "git+https://github.com/hologfx/holographics-client-sdk.git",
		"html-webpack-plugin": "^4.3.0",
		"http-proxy-middleware": "^1.0.4",
		"jquery": "^3.5.1",
		"mocha": "^7.2.0",
		"mousetrap": "^1.6.5",
		"nodemon": "^2.0.4",
		"ntl": "^5.0.0",
		"popper.js": "^1.16.1",
		"pug-plain-loader": "^1.0.0",
		"sass": "^1.26.8",
		"sass-loader": "^7.3.1",
		"socket.io-client": "^2.3.0",
		"speed-measure-webpack-plugin": "^1.3.3",
		"style-loader": "^0.23.1",
		"uglify": "^0.1.5",
		"vue": "^2.6.11",
		"vue-loader": "^15.9.2",
		"vue-markdown": "^2.2.4",
		"vue-router": "^3.3.2",
		"vue-socket.io": "^3.0.9",
		"vue-template-compiler": "^2.6.11",
		"vuedraggable": "^2.23.2",
		"vuex": "^3.4.0",
		"webpack": "^4.43.0",
		"webpack-cli": "^3.3.11",
		"webpack-dev-server": "^3.11.0",
		"webpack-merge": "^4.2.2",
		"webpack-node-externals": "^1.7.2"
	}
}
